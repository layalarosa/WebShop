@model WebShop.ViewModels.ShoppingCartViewModel

<h2 class="mb-4">Your shopping cart</h2>

<div class="table-responsive">
    <table class="table align-middle">
        <thead class="table-light">
            <tr>
                <th style="width:100px;">Qty</th>
                <th>Game</th>
                <th class="text-end">Price</th>
                <th class="text-end">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.ShoppingCart.ShoppingCartItems)
            {
                <tr>
                    <td class="text-center">@line.Amount</td>
                    <td>@line.Game.Name</td>
                    <td class="text-end">@line.Game.Price.ToString("c")</td>
                    <td class="text-end">@((line.Amount * line.Game.Price).ToString("c"))</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end fw-bold">Total:</td>
                <td class="text-end fw-bold">@Model.ShoppingCartTotal.ToString("c")</td>
            </tr>
        </tfoot>
    </table>
</div>

<div class="d-flex justify-content-center mt-4">
    <a class="btn btn-primary btn-lg" asp-controller="Order" asp-action="Checkout">Check out now!</a>
</div>
