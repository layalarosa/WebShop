@model WebShop.ViewModels.ShoppingCartViewModel

@if (Model.ShoppingCart.ShoppingCartItems?.Count > 0)
{
    <a class="nav-link position-relative" asp-controller="ShoppingCart" asp-action="Index">
        <span class="shopping-cart-badge">@Model.ShoppingCart.ShoppingCartItems.Count</span>
    </a>
}
